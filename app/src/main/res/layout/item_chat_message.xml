<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/chatBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_assistant"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/chatRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lt_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/thinkingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/thinkingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/lt_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/thinkingChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸"
                android:textColor="@color/lt_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/thinkingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_thinking"
            android:padding="10dp"
            android:textColor="@color/lt_text_secondary"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chatContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/lt_text_primary"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chatSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/lt_text_secondary"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chatMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/lt_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
