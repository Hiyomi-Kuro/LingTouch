<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/stepIndex"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:textColor="@color/lt_on_primary_container"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/lt_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/lt_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/stepIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/task_steps" />
</LinearLayout>
